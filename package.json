{
  "name": "voice-turn-pipeline",
  "version": "0.1.0",
  "description": "Streaming voice-turn orchestration (STT -> your reply callback -> TTS) for real-time WebSocket agents. Vendor- and transport-agnostic; Deepgram/Cartesia/ElevenLabs providers included.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch"
  },
  "keywords": [
    "voice",
    "speech-to-text",
    "text-to-speech",
    "streaming",
    "websocket",
    "deepgram",
    "cartesia",
    "elevenlabs",
    "realtime-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zarrock77/voice-turn-pipeline.git"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.11.0"
  },
  "peerDependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.13",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "ws": "^8.19.0"
  }
}
